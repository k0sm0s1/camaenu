      <!-- Tried thinning this from 0.035 0.035 0.10 (7x7x20cm) to
           0.015 0.015 0.10 (3x3x20cm) per direct request, on the
           hypothesis that a narrower cross-section brings the box's
           near face closer to its own centre, so the trunk-shaft
           contact that triggers the grasp (elephant_grasp_cv.py round 4)
           would happen with the box's CENTRE closer to the mount.
           DIRECTLY TESTED AND REVERTED: an isolated 45-simulated-second
           run with the thinner box never touched it even once
           (min_upright_seen stayed at exactly 1.0000 the whole run,
           trigger=None) -- a narrower target is a smaller thing for the
           trunk's own sway/droop to graze while walking, so thinning it
           made contact LESS likely, not more precisely positioned when
           it happens. Reverted to the original 7x7x20cm size below; see
           the roadmap for the full result. -->
      <!-- Footprint halved to 3.5x3.5 cm (half-size 0.0175) on request, height still 20 cm, mass still 0.5 kg. -->
      <geom name="test_cube_geom" type="box" size="0.0175 0.0175 0.10" mass="0.5" material="cube_mat" contype="1" conaffinity="1" friction="1.5 0.15 0.05"/>
