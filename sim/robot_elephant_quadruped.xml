      <camera name="chest_cam" pos="0.3000 0 -0.1400" xyaxes="0 -1 0 0.5736 0 0.8192" fovy="85"/>
      <geom name="chest_cam_marker" type="sphere" pos="0.3000 0 -0.1400" size="0.014" material="eye_mat" contype="0" conaffinity="0" mass="0.001"/>
